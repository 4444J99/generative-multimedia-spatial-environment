{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": false,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "types": ["google.analytics", "howler", "jquery", "node"]
  },
  "include": [
    "js/globals.d.ts",
    "js/main.js",
    "js/worksGallery.js",
    "js/modules/ChamberLoader.js",
    "js/runtimeFallback.js",
    "js/page.js",
    "js/pageData.js",
    "js/images.js",
    "js/diary.js",
    "js/ogod.js",
    "js/analytics.js",
    "js/config.js",
    "js/audioPlayer.js",
    "js/videoPlayer.js",
    "js/nameSearch.js",
    "js/namingAPI.js",
    "js/namingStrategies.js",
    "js/loophole.js",
    "js/sketch.js",
    "js/3d/ui/*.js",
    "js/living-pantheon/*.js",
    "js/media/**/*.js",
    "js/ergasterion/*.js",
    "js/ogod/utils/*.js",
    "js/generative/*.js",
    "js/ai/*.js"
  ]
}
